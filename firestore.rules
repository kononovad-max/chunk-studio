rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Progress of one learner lives under progress/<sync code>/docs.
    // The 19-character code (16 random symbols) works as a private key: only devices that know it can read or write.
    match /progress/{code}/docs/{doc} {
      allow read, write: if request.auth != null
        && code.matches('^[A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4}$')
        && (doc == 'meta' || doc.matches('^b[0-9a-f]$'))
        && (request.method == 'get' || request.method == 'list' || request.method == 'delete' || request.resource.size() <= 400);
    }
  }
}
